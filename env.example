# Copia questo file in ".env" e riempi i valori veri.
# NON caricare mai il file ".env" reale su GitHub o altrove pubblico.

# Stringa di connessione al tuo cluster MongoDB Atlas gratuito.
# Vedi il README, sezione 0, per come ottenerla.
MONGODB_URI=INCOLLA_QUI_LA_STRINGA_DI_CONNESSIONE_MONGODB_ATLAS

# Dashboard Stripe -> Sviluppatori -> Chiavi API (usa la chiave "segreta")
# In fase di test usa quella che inizia con "sk_test_", quando sei pronto
# per soldi veri passa a quella che inizia con "sk_live_".
STRIPE_SECRET_KEY=INCOLLA_QUI_LA_TUA_CHIAVE_SEGRETA_STRIPE

# Dashboard Stripe -> Sviluppatori -> Webhook -> (dopo aver creato l'endpoint)
# "Signing secret" dell'endpoint /api/webhook (inizia con "whsec_")
STRIPE_WEBHOOK_SECRET=INCOLLA_QUI_IL_SIGNING_SECRET_DEL_WEBHOOK

# L'indirizzo del tuo sito (dove sta prodevunity-site.html), usato per i
# redirect di ritorno da Stripe dopo un pagamento. In locale es. http://localhost:5500
FRONTEND_URL=https://il-tuo-sito.esempio.com

# Percentuale trattenuta dalla piattaforma sui pagamenti tra privati
FEE_PERCENT=15

# Invio email reale del codice di conferma (usa Gmail).
# EMAIL_USER: il tuo indirizzo Gmail (es. tuonome@gmail.com)
# EMAIL_APP_PASSWORD: una "password per le app" generata da Google
# (NON la password normale del tuo account) — vedi il README, sezione 8.
EMAIL_USER=tuonome@gmail.com
EMAIL_APP_PASSWORD=INCOLLA_QUI_LA_PASSWORD_PER_LE_APP_DI_GOOGLE
EMAIL_FROM=tuonome@gmail.com

# Invio SMS reale del codice di conferma per chi si registra con un
# numero di telefono, tramite Twilio (twilio.com). Vedi il README, sezione 9.
TWILIO_ACCOUNT_SID=INCOLLA_QUI_IL_TUO_ACCOUNT_SID_TWILIO
TWILIO_AUTH_TOKEN=INCOLLA_QUI_IL_TUO_AUTH_TOKEN_TWILIO
TWILIO_PHONE_NUMBER=+15551234567
# Prefisso usato se qualcuno scrive il numero senza (es. "3331234567")
TWILIO_DEFAULT_COUNTRY_CODE=+39

# Porta su cui gira il server (molti hosting la impostano da soli)
PORT=4242
